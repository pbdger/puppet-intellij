<idea-plugin>
    <id>de.fovea.puppet</id>
    <name>Puppet</name>
    <vendor>Fovea</vendor>

    <description><![CDATA[
        Puppet language support for IntelliJ IDEA 2025 using Puppet Editor Services.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.ultimate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Puppet"
                  language="Puppet"
                  implementationClass="de.fovea.puppet.language.PuppetFileType"
                  fieldName="INSTANCE"
                  extensions="pp;epp"
                  fileNames="Puppetfile"/>
        <externalAnnotator language="Puppet" implementationClass="de.fovea.puppet.diagnostics.PuppetExternalAnnotator"/>
        <completion.contributor language="Puppet" implementationClass="de.fovea.puppet.completion.PuppetCompletionContributor"/>
        <lang.findUsagesProvider language="Puppet" implementationClass="de.fovea.puppet.navigation.PuppetFindUsagesProvider"/>
        <renamePsiElementProcessor implementation="de.fovea.puppet.navigation.PuppetRenameProcessor"/>
        <lang.parserDefinition language="Puppet" implementationClass="de.fovea.puppet.language.PuppetParserDefinition"/>
        <fileBasedIndex implementation="de.fovea.puppet.index.PuppetDeclarationFileIndex"/>
        <psi.referenceContributor language="Puppet" implementation="de.fovea.puppet.navigation.PuppetReferenceContributor"/>
        <lang.psiStructureViewFactory language="Puppet" implementationClass="de.fovea.puppet.structure.PuppetStructureViewFactory"/>
        <lang.syntaxHighlighterFactory language="Puppet"
                implementationClass="de.fovea.puppet.language.PuppetSyntaxHighlighterFactory"/>
        <platform.lsp.serverSupportProvider
                implementation="de.fovea.puppet.lsp.PuppetLspServerSupportProvider"/>
        <applicationConfigurable parentId="tools"
                instance="de.fovea.puppet.settings.PuppetSettingsConfigurable"
                id="de.fovea.puppet.settings" displayName="Puppet"/>
    </extensions>

    <actions>
        <group id="Puppet.Tools" text="Puppet" description="Puppet, PDK and language server actions" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>

            <action id="Puppet.GoToClass" class="de.fovea.puppet.navigation.PuppetClassNavigationAction"
                    text="Go to Puppet Class..." description="Find a Puppet class or defined type in the project"/>
            <action id="Puppet.ModuleInfo" class="de.fovea.puppet.navigation.PuppetModuleInfoAction"
                    text="Show Puppet Module" description="Show the detected Puppet module root and areas"/>
            <separator/>
            <action id="Puppet.ParserValidate" class="de.fovea.puppet.actions.PuppetParserValidateAction"
                    text="Parser Validate Current Manifest" description="Run puppet parser validate for the selected manifest"/>
            <action id="Puppet.Lint" class="de.fovea.puppet.actions.PuppetLintAction"
                    text="Lint Current Manifest" description="Run puppet-lint for the selected manifest"/>
            <separator/>
            <action id="Puppet.PdkValidate" class="de.fovea.puppet.actions.PdkValidateAction"
                    text="PDK Validate" description="Run pdk validate in the current Puppet module"/>
            <action id="Puppet.PdkUnitTest" class="de.fovea.puppet.actions.PdkUnitTestAction"
                    text="PDK Unit Test" description="Run pdk test unit in the current Puppet module"/>
            <separator/>
            <action id="Puppet.PdkNewClass" class="de.fovea.puppet.actions.PdkNewClassAction"
                    text="PDK New Class..." description="Create a Puppet class using PDK"/>
            <action id="Puppet.PdkNewDefinedType" class="de.fovea.puppet.actions.PdkNewDefinedTypeAction"
                    text="PDK New Defined Type..." description="Create a Puppet defined type using PDK"/>
            <separator/>
            <action id="Puppet.Versions" class="de.fovea.puppet.actions.PuppetVersionsAction"
                    text="Show Tool Versions" description="Show detected Puppet, PDK, puppet-lint and language server versions"/>
            <action id="Puppet.LspStatus" class="de.fovea.puppet.actions.PuppetLspStatusAction"
                    text="Language Server Status" description="Show Puppet language server status"/>
            <action id="Puppet.LspRestart" class="de.fovea.puppet.actions.PuppetLspRestartAction"
                    text="Restart Language Server" description="Restart Puppet language server"/>
        </group>
    </actions>
</idea-plugin>
